#!/system/bin/sh
# Rondo 2.0 at boot: init's "rondo" service (firmware/build.sh puts it in init.rc) runs this, and this
# runs Rondo, again at once whenever it ends (an update put in place, a crash: back in about a second,
# with the queue it kept).
#
# Which Rondo: the update named in /data/rondo/current (native/core/bundle.h unpacks it into
# /data/rondo/<version>), else the firmware's own copy in /system/rondo. Rondo clears
# /data/rondo/crashes once it has run 30 s; three quick ends in a row set the update aside
# (current.failed) and the firmware's copy runs.
D=/data/rondo
mkdir -p $D
chmod 0700 $D

# What Android's Java layer did at boot, which nothing else does without it:
#
# - The display: SurfaceFlinger starts with init's main class and sets the panel up (its boot animation
#   is off: debug.sf.nobootanimation); once it has, it stops, and Rondo draws to the framebuffer, as
#   in every development run on 1.0.x's firmware.
# - The sound: mediaserver up before Rondo opens its output.
# - The storage: vold mounts nothing by itself (MountService asked it to): the card and the internal
#   storage, each once vold has found it (state 1, idle).
#   SurfaceFlinger registers its service once its setup (readyToRun) is done, and turns the panel on in
#   the message right after: its registration and 0.3 s more, at most 10 s (a fixed 1.5 s before Nov 9;
#   restarted on the Y1 it registers 20 ms after it runs).
i=0
while [ $i -lt 100 ] && ! service check SurfaceFlinger | grep -q found; do sleep 0.1; i=$((i + 1)); done
sleep 0.3
stop surfaceflinger
i=0
while [ $i -lt 50 ] && ! service check media.audio_flinger | grep -q found; do sleep 0.2; i=$((i + 1)); done
i=0
while [ $i -lt 50 ]; do
  left=0
  vdc volume list | while read code n label path state; do
    [ "$code" = 110 ] || continue
    [ "$state" = 1 ] && vdc volume mount $path > /dev/null 2>&1
  done
  for path in $(vdc volume list | while read code n label path state; do [ "$code" = 110 ] && [ "$state" != 4 ] && echo $path; done); do left=1; done
  [ $left = 0 ] && break
  sleep 0.2
  i=$((i + 1))
done

while true; do
  dir=/system/rondo
  n=0
  [ -f $D/crashes ] && n=$(cat $D/crashes)
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  if [ -f $D/current ]; then
    v=$(cat $D/current)
    if [ "$n" -ge 3 ]; then
      mv $D/current $D/current.failed
      echo "rondo-start: $v ended three times in a row: the firmware's own Rondo runs" >> $D/start.log
      n=0
    elif [ -n "$v" ] && [ -x "$D/$v/rondo" ]; then
      dir=$D/$v
    fi
  fi
  echo $((n + 1)) > $D/crashes
  [ -f $D/rondo.log ] && mv $D/rondo.log $D/rondo.log.1
  (cd $dir && LD_LIBRARY_PATH=$dir/lib:/vendor/lib:/system/lib exec ./rondo) > $D/rondo.log 2>&1
  sleep 0.2
done
